<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- "Play Video File…" feeds a recording through the pipeline in place
	     of the camera, for the repeatable measurement runs. Under the App
	     Sandbox the open panel still appears without this, and the chosen
	     file then fails to read — a failure that looks like a broken video
	     rather than a missing entitlement. -->
	<!-- Read-write, not read-only, because the Measurement Report also
	     *writes*: Export CSV saves the Subbab 4.4 tables wherever the user
	     picks. Read-only would let the save panel appear and then fail at
	     the write, which reads as a broken export rather than a missing
	     entitlement. Read-write is a superset, so the video picker above
	     keeps working. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Card art is fetched from cmsassets.rgpub.io. Under the App
	     Sandbox outgoing connections are denied unless this is set, so
	     without it every AsyncImage in Card Details fails and renders its
	     placeholder — which reads as a black rectangle on a dark panel. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
